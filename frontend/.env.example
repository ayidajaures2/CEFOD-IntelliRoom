# ============================================================
# CEFOD IntelliRoom — configuration frontend
# Copier ce fichier en `.env` puis ajuster :
#     cp .env.example .env
# ============================================================

# URL de base de l'API Laravel (sans slash final)
VITE_API_URL=http://localhost:8000/api

# Intervalle du polling temps réel (ms) — cahier des charges : 5000
VITE_POLLING_INTERVAL=5000
